{
  "schema_version": 1,
  "experiment_id": "e1_tfidf_logistic_regression",
  "seed": 6405,
  "c_grid": [0.1, 1.0, 10.0],
  "selection": {
    "dataset": "d1_validation",
    "metric": "macro_f1",
    "threshold": 0.5,
    "tie_break": "smaller_C"
  },
  "vectorizers": {
    "word": {
      "analyzer": "word",
      "ngram_range": [1, 2],
      "max_features": 50000,
      "lowercase": true,
      "norm": "l2",
      "sublinear_tf": false
    },
    "char": {
      "analyzer": "char",
      "ngram_range": [3, 5],
      "max_features": 50000,
      "lowercase": true,
      "norm": "l2",
      "sublinear_tf": false
    },
    "combined": {
      "branches": ["word", "char"]
    }
  },
  "classifier": {
    "type": "LogisticRegression",
    "solver": "liblinear",
    "regularization": "l2",
    "l1_ratio": 0.0,
    "class_weight": null,
    "max_iter": 1000
  },
  "thresholds": {
    "primary": "tF1",
    "tF1_tie_break": "higher_threshold",
    "t5_max_validation_fpr": 0.05,
    "t5_tie_break": "higher_threshold",
    "prediction_rule": "score_attack >= threshold"
  },
  "evaluation_datasets": ["d1_test", "d2_test", "d3_test"],
  "latency": {
    "warmup_samples": 10,
    "measured_samples": 100,
    "batch_size": 1,
    "includes_vectorization": true
  },
  "local_explanations": {
    "selection": "first_three_source_rows_per_class_from_d1_test",
    "top_features_per_sample": 12
  }
}
